rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the request from a logged-in user?
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: is the request from the owner of this doc (by uid)?
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Helper: is the request from a user whose role == 'admin'?
    // Reads the requester's own /users/{uid} doc to check their role.
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ---------------------------
    // users/{userId}
    // ---------------------------
    match /users/{userId} {
      // A user can read/write only their own profile.
      // Admins can read any profile (needed for admin views).
      allow read: if isOwner(userId) || isAdmin();

      // Signup: must be creating their own doc, must start as a regular
      // user with a pending ID review — prevents self-assigning admin
      // or a pre-approved ID status at account creation.
      allow create: if isOwner(userId) &&
        request.resource.data.role == 'user' &&
        request.resource.data.idStatus == 'pending';

      // Owner can update their own profile (e.g. completing missing
      // fields), but can't change their own role, idStatus, or idNumber —
      // those are admin-only, via the isAdmin() branch below.
      allow update: if isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.get('idStatus', null) == resource.data.get('idStatus', null) &&
        request.resource.data.get('idNumber', null) == resource.data.get('idNumber', null);

      // Admins can update any user doc, including role and ID approval.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------------------------
    // events/{eventId}
    // ---------------------------
    match /events/{eventId} {
      // Any signed-in user can read events.
      allow read: if isSignedIn();
      // Only admins can create, edit, or change status/archive events.
      allow create, update, delete: if isAdmin();
    }

    // ---------------------------
    // registrations/{registrationId}
    // ---------------------------
    match /registrations/{registrationId} {
      // A user can read their own registrations; admins can read all
      // (needed for registrant lists / attendance / printing).
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);

      // A user can only create a registration for themselves.
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;

      // Only admins can update (e.g. marking attendance).
      allow update: if isAdmin();

      // No deletes from the client — keep registrations as a permanent record.
      allow delete: if false;
    }

    // ---------------------------
    // announcements/{announcementId}
    // ---------------------------
    match /announcements/{announcementId} {
      // Any signed-in user can read announcements.
      allow read: if isSignedIn();
      // Only admins can post, edit, or delete announcements.
      allow create, update, delete: if isAdmin();
    }

    // ---------------------------
    // settings/{docId}  (e.g. certificateTemplate, idTemplate, idCounter)
    // ---------------------------
    match /settings/{docId} {
      // Any signed-in user can read (needed to generate their own certificate/ID).
      allow read: if isSignedIn();
      // Only admins can update settings like templates or the ID counter.
      allow write: if isAdmin();
    }

    // Default deny for anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
