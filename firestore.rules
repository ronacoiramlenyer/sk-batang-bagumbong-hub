rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the request from a logged-in user?
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: is the request from the owner of this doc (by uid)?
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Helper: is the request from a user whose role == 'admin'?
    // Reads the requester's own /users/{uid} doc to check their role.
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ---------------------------
    // users/{userId}
    // ---------------------------
    match /users/{userId} {
      // A user can read/write only their own profile.
      // Admins can read any profile (needed for admin views).
      allow read: if isOwner(userId) || isAdmin();

      // Signup: must be creating their own doc, must start as a regular
      // user with a pending ID review — prevents self-assigning admin
      // or a pre-approved ID status at account creation.
      allow create: if isOwner(userId) &&
        request.resource.data.role == 'user' &&
        request.resource.data.idStatus == 'pending';

      // Owner can update their own profile (e.g. completing missing
      // fields), but can't change their own role, idStatus, or idNumber —
      // those are admin-only, via the isAdmin() branch below. Address can
      // only be SET for the first time this way (e.g. completing an
      // originally-empty profile) — changing an address that's already on
      // file has to go through an addressChangeRequests doc instead, which
      // only an admin can approve.
      allow update: if isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.get('idStatus', null) == resource.data.get('idStatus', null) &&
        request.resource.data.get('idNumber', null) == resource.data.get('idNumber', null) &&
        (
          request.resource.data.get('address', '') == resource.data.get('address', '') ||
          resource.data.get('address', '') == ''
        );

      // Admins can update any user doc, including role, ID approval,
      // and applying an approved address change.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------------------------
    // addressChangeRequests/{userId}  (doc ID == the requester's uid)
    // ---------------------------
    match /addressChangeRequests/{userId} {
      // Owner reads their own; admin reads all (needed for the review queue).
      allow read: if isOwner(userId) || isAdmin();

      // Owner can only submit a request for themselves, and only while no
      // request is already pending (prevents piling up duplicate requests).
      allow create: if isOwner(userId) &&
        request.resource.data.userId == userId &&
        request.resource.data.status == 'pending' &&
        (!exists(/databases/$(database)/documents/addressChangeRequests/$(userId)) ||
         get(/databases/$(database)/documents/addressChangeRequests/$(userId)).data.status != 'pending');

      // Only admins can approve/reject. Owners can also "update" here —
      // because the client resubmits via .set(), Firestore treats a second
      // request (after a prior one was already resolved) as an update, not
      // a create, once the doc exists — so this mirrors the create rule
      // above for that resubmission case.
      allow update: if isAdmin() ||
        (isOwner(userId) &&
         resource.data.status != 'pending' &&
         request.resource.data.userId == userId &&
         request.resource.data.status == 'pending');

      allow delete: if isAdmin();
    }

    // ---------------------------
    // events/{eventId}
    // ---------------------------
    match /events/{eventId} {
      // Any signed-in user can read events.
      allow read: if isSignedIn();
      // Only admins can create, edit, or change status/archive events.
      allow create, update, delete: if isAdmin();
    }

    // ---------------------------
    // registrations/{registrationId}
    // ---------------------------
    match /registrations/{registrationId} {
      // A user can read their own registrations; admins can read all
      // (needed for registrant lists / attendance / printing).
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);

      // A user can only create a registration for themselves.
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;

      // Only admins can update (e.g. marking attendance).
      allow update: if isAdmin();

      // No deletes from the client — keep registrations as a permanent record.
      allow delete: if false;
    }

    // ---------------------------
    // announcements/{announcementId}
    // ---------------------------
    match /announcements/{announcementId} {
      // Any signed-in user can read announcements.
      allow read: if isSignedIn();
      // Only admins can post, edit, or delete announcements.
      allow create, update, delete: if isAdmin();
    }

    // ---------------------------
    // settings/{docId}  (e.g. certificateTemplate, idTemplate, idCounter)
    // ---------------------------
    match /settings/{docId} {
      // Any signed-in user can read (needed to generate their own certificate/ID).
      allow read: if isSignedIn();
      // Only admins can update settings like templates or the ID counter.
      allow write: if isAdmin();
    }

    // ---------------------------
    // conversations/{userId}  (doc ID == the user's uid)
    // conversations/{userId}/messages/{messageId}
    // ---------------------------
    match /conversations/{userId} {
      // Owner and admin can both read/write the conversation's metadata
      // (last message preview, unread flags) — used by both sides.
      allow read, write: if isOwner(userId) || isAdmin();

      match /messages/{messageId} {
        allow read: if isOwner(userId) || isAdmin();
        // Anyone in the conversation can post, but only as themselves —
        // no impersonating the other party.
        allow create: if (isOwner(userId) || isAdmin()) &&
          request.resource.data.senderId == request.auth.uid;
        // Messages are immutable once sent.
        allow update, delete: if false;
      }
    }

    // Default deny for anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
