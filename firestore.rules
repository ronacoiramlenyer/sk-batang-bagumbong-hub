rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the request from a logged-in user?
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: is the request from the owner of this doc (by uid)?
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Helper: is the request from an admin OR a super admin? Super admin is
    // a superset of admin — everything isAdmin() gates, a super admin can
    // also do — so this intentionally covers both roles. Use isSuperAdmin()
    // below for the handful of actions reserved for super admin only.
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }

    // Helper: is the request from a super admin specifically? Reserved for
    // deleting a user, rejecting an ID application, and removing/restoring
    // an event registrant — regular admins can do everything else.
    function isSuperAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    // Helper: has this event's optional registrationOpensAt passed yet?
    // request.time is the server's own clock — untamperable by the client,
    // unlike anything computed from new Date() in the app's JS — which is
    // what makes this the actual enforcement rather than just a UI nicety.
    function eventRegistrationIsOpen(eventId) {
      let opensAt = get(/databases/$(database)/documents/events/$(eventId)).data.get('registrationOpensAt', null);
      return opensAt == null || request.time >= opensAt;
    }

    // ---------------------------
    // users/{userId}
    // ---------------------------
    match /users/{userId} {
      // A user can read/write only their own profile.
      // Admins can read any profile (needed for admin views).
      allow read: if isOwner(userId) || isAdmin();

      // Signup: must be creating their own doc, must start as a regular
      // user with a pending ID review — prevents self-assigning admin
      // or a pre-approved ID status at account creation.
      allow create: if isOwner(userId) &&
        request.resource.data.role == 'user' &&
        request.resource.data.idStatus == 'pending';

      // Owner can update their own profile to complete originally-missing
      // fields (e.g. legacy accounts filling in address/birthdate/contact
      // for the first time), but can't change their own role, idStatus, or
      // idNumber (admin-only, via the isAdmin() branch below). Once a field
      // is set, changing it later requires a profileChangeRequests doc with
      // admin approval instead — fullName is never self-editable at all,
      // since it's always set at signup.
      allow update: if isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.get('idStatus', null) == resource.data.get('idStatus', null) &&
        request.resource.data.get('idNumber', null) == resource.data.get('idNumber', null) &&
        request.resource.data.get('fullName', '') == resource.data.get('fullName', '') &&
        (
          request.resource.data.get('birthdate', '') == resource.data.get('birthdate', '') ||
          resource.data.get('birthdate', '') == ''
        ) &&
        (
          request.resource.data.get('contactNumber', '') == resource.data.get('contactNumber', '') ||
          resource.data.get('contactNumber', '') == ''
        ) &&
        (
          request.resource.data.get('address', '') == resource.data.get('address', '') ||
          resource.data.get('address', '') == ''
        );

      // Owner can resubmit their photo/ID after a rejection — the only
      // way idStatus can move from 'rejected' back to 'pending' without an
      // admin, and only alongside a new photo/ID (nothing else changes).
      allow update: if isOwner(userId) &&
        resource.data.idStatus == 'rejected' &&
        request.resource.data.idStatus == 'pending' &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.get('idNumber', null) == resource.data.get('idNumber', null) &&
        request.resource.data.get('fullName', '') == resource.data.get('fullName', '') &&
        request.resource.data.get('birthdate', '') == resource.data.get('birthdate', '') &&
        request.resource.data.get('contactNumber', '') == resource.data.get('contactNumber', '') &&
        request.resource.data.get('address', '') == resource.data.get('address', '') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['idStatus', 'photoData', 'idDocumentData']);

      // Admins (regular or super) can update any user doc — role, ID
      // approval or rejection, applying an approved profile change
      // request, etc. Deleting a user (below) stays super-admin-only.
      allow update: if isAdmin();

      // Deleting a user is reserved for super admin.
      allow delete: if isSuperAdmin();
    }

    // ---------------------------
    // profileChangeRequests/{userId}  (doc ID == the requester's uid)
    // Covers fullName, birthdate, contactNumber, and address in one
    // request, with a required proof photo (ID or recent photo).
    // ---------------------------
    match /profileChangeRequests/{userId} {
      // Owner reads their own; admin reads all (needed for the review queue).
      allow read: if isOwner(userId) || isAdmin();

      // Owner can only submit a request for themselves, and only while no
      // request is already pending (prevents piling up duplicate requests).
      allow create: if isOwner(userId) &&
        request.resource.data.userId == userId &&
        request.resource.data.status == 'pending' &&
        (!exists(/databases/$(database)/documents/profileChangeRequests/$(userId)) ||
         get(/databases/$(database)/documents/profileChangeRequests/$(userId)).data.status != 'pending');

      // Only admins can approve/reject. Owners can also "update" here —
      // because the client resubmits via .set(), Firestore treats a second
      // request (after a prior one was already resolved) as an update, not
      // a create, once the doc exists — so this mirrors the create rule
      // above for that resubmission case.
      allow update: if isAdmin() ||
        (isOwner(userId) &&
         resource.data.status != 'pending' &&
         request.resource.data.userId == userId &&
         request.resource.data.status == 'pending');

      allow delete: if isAdmin();
    }

    // ---------------------------
    // events/{eventId}
    // ---------------------------
    match /events/{eventId} {
      // Any signed-in user can read events.
      allow read: if isSignedIn();
      // Any admin can create an event, but deleting one (permanent, and
      // cascades to its registrations client-side) is super-admin-only —
      // same tier as deleting a user or a conversation.
      allow create: if isAdmin();
      allow delete: if isSuperAdmin();

      // Admins can edit anything. A non-admin registering for the event is
      // allowed exactly one kind of update: bumping registeredCount by 1,
      // and only while still under capacity — this is what lets the join
      // transaction enforce a participant limit without giving clients
      // general write access to event docs. Any other field change, or an
      // increment when already at/over capacity, is rejected.
      allow update: if isAdmin() ||
        (isSignedIn() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredCount']) &&
         request.resource.data.registeredCount == resource.data.get('registeredCount', 0) + 1 &&
         (resource.data.get('capacity', null) == null ||
          resource.data.get('registeredCount', 0) < resource.data.capacity));
    }

    // ---------------------------
    // registrations/{registrationId}
    // ---------------------------
    match /registrations/{registrationId} {
      // A user can read their own registrations; admins can read all
      // (needed for registrant lists / attendance / printing).
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);

      // A user can only create a registration for themselves, and only
      // once their SK Barangay ID is approved (admins are exempt — they
      // don't go through that process) AND the event's optional
      // registration-opens-at time has actually passed on the server's
      // clock. This is the authoritative check for both; the app also
      // disables the Join button client-side for a clean message instead
      // of a dead click, but this is what actually stops someone from
      // bypassing either by calling Firestore directly (e.g. by setting
      // their device's clock forward).
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        (isAdmin() ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.idStatus == 'approved') &&
        eventRegistrationIsOpen(request.resource.data.eventId);

      // Admins can update (e.g. marking attendance), except changing the
      // `removed` flag itself — removing or restoring a registrant — which
      // is reserved for super admin.
      allow update: if isSuperAdmin() ||
        (isAdmin() &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['removed']));

      // Individual removal is the soft `removed` flag above, not an actual
      // delete (see the reason preserved permanently as a message in a
      // threads doc) — an actual delete here only ever happens as part of
      // a super admin deleting the whole event (cascading cleanup so
      // registrations don't get orphaned pointing at a deleted event).
      allow delete: if isSuperAdmin();
    }

    // ---------------------------
    // announcements/{announcementId}
    // ---------------------------
    match /announcements/{announcementId} {
      // Any signed-in user can read announcements.
      allow read: if isSignedIn();
      // Only admins can post, edit, or delete announcements.
      allow create, update, delete: if isAdmin();
    }

    // ---------------------------
    // settings/{docId}  (e.g. certificateTemplate, idTemplate, idCounter)
    // ---------------------------
    match /settings/{docId} {
      // Any signed-in user can read (needed to generate their own certificate/ID).
      allow read: if isSignedIn();
      // Only admins can update settings like templates or the ID counter.
      allow write: if isAdmin();
    }

    // ---------------------------
    // threads/{threadId}  (auto-generated ID — a user can have many)
    // threads/{threadId}/messages/{messageId}
    // ---------------------------
    match /threads/{threadId} {
      // Owner reads/writes only their own threads; admin reads/writes all.
      allow read, update: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);

      // Starting a new thread — must be the owner's own userId, unless an
      // admin is opening one on a resident's behalf (the automatic "why
      // you were rejected/removed" messages — rejecting an ID is open to
      // any admin; removing a registrant is super-admin-only, but that
      // distinction is enforced on the registration write itself, not here).
      allow create: if isSignedIn() &&
        (request.resource.data.userId == request.auth.uid || isAdmin());

      // Deleting a whole conversation is super-admin-only (same tier as
      // deleting a user) — not exposed to a regular admin.
      allow delete: if isSuperAdmin();

      match /messages/{messageId} {
        // Ownership is checked via the parent thread doc, since threadId
        // is a random ID (not the user's uid like the old model).
        allow read: if isAdmin() ||
          (isSignedIn() &&
           get(/databases/$(database)/documents/threads/$(threadId)).data.userId == request.auth.uid);

        // Anyone in the thread can post, but only as themselves.
        allow create: if (isAdmin() ||
          (isSignedIn() &&
           get(/databases/$(database)/documents/threads/$(threadId)).data.userId == request.auth.uid)) &&
          request.resource.data.senderId == request.auth.uid;

        // Immutable once sent — never editable. Deletable only as part of
        // a super admin deleting the whole conversation above (individual
        // messages can't be picked off one at a time).
        allow update: if false;
        allow delete: if isSuperAdmin();
      }
    }

    // Default deny for anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
